# Installed to /etc/agentgate/agentgate.env by bootstrap-ec2.sh and read by the
# systemd unit. Keep it 0640 root:agentgate: it can hold an AI key.
#
# systemd parses this file like a shell, so it strips bare double quotes. Any
# JSON value must be wrapped in single quotes or pydantic receives malformed
# JSON and the service refuses to start.

AGENTGATE_APP_NAME=AgentGate
AGENTGATE_ENVIRONMENT=production

# Browser origins allowed to call this API across origins.
#
# Empty is correct for the default topology: the browser talks to Vercel, and
# Vercel's rewrite reaches this box server-side. The browser only ever sees its
# own origin, so no CORS header is involved and none should be granted.
AGENTGATE_CORS_ORIGINS=[]

# Direct mode only (Option B in DEPLOY_VERCEL.md), where the browser calls this
# backend itself. Requires TLS here; see enable-tls.sh.
# AGENTGATE_CORS_ORIGINS='["https://agentgate.vercel.app"]'
#
# Vercel names every preview deployment differently, so previews are allowed by
# pattern instead. Starlette matches this against the whole origin.
# AGENTGATE_CORS_ORIGIN_REGEX=https://agentgate-[a-z0-9-]+-[a-z0-9-]+\.vercel\.app

# Optional. Enables the AI draft in Policy Studio; the gate works without it.
# AGENTGATE_AI_API_KEY=sk-...
# AGENTGATE_AI_BASE_URL=https://api.openai.com/v1
# AGENTGATE_AI_MODEL=gpt-4o-mini
