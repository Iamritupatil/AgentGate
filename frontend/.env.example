# Optional: copy to frontend/.env. Defaults work without this file.
#
# Leave VITE_API_BASE_URL as /api for both local development and the Vercel
# deployment: locally Vite proxies /api to the backend, and on Vercel the
# rewrite in vercel.json proxies it to EC2. Same-origin either way, so the
# browser never sees CORS and never blocks a mixed-content request.
VITE_API_BASE_URL=/api
# Used only by Vite's local dev/preview proxy; never exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Direct mode (Option B in DEPLOY_VERCEL.md): skip the Vercel proxy and call a
# TLS-terminated backend straight from the browser. Requires a real domain with
# a certificate on the EC2 box, and AGENTGATE_CORS_ORIGINS set to your Vercel
# origin. Anything in a VITE_ variable is baked into the public bundle, so put
# no credential here.
# VITE_API_BASE_URL=https://api.example.com/api
